# Copy to .env and fill every blank secret.
# Empty required values fail at startup; no fake secret is provided.
DJANGO_SECRET_KEY=
INTERNAL_API_TOKEN=
AGENT_RUN_AUTHORIZATION_SIGNING_KEY=
CREDENTIAL_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
BOOTSTRAP_SUPERADMIN_PASSWORD=
COMPOSE_PROJECT_NAME=centaeris-workspace
POSTGRES_DB=centaeris
POSTGRES_USER=centaeris
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_DEBUG=1
API_WORKERS=1
STORAGE_ROOT=/var/lib/centaeris-storage
STORAGE_STREAM_LANES=4
STORAGE_STREAM_CHUNK_BYTES=65536
REDIS_BROWSER_MAX_CONNECTIONS=8
REDIS_URL=redis://redis:6379/0
RUNTIME_URL=http://runtime:9000
RUNTIME_PORT=9000
RUNTIME_START_TIMEOUT_SECONDS=30
RUNTIME_STREAM_TTL_SECONDS=3600
RUNTIME_LIVE_STATE_TTL_SECONDS=3600
API_INTERNAL_URL=http://api:8000
API_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
WEB_HOST_PORT=3000
API_HOST_PORT=8000
PASSWORD_RESET_ENABLED=0
PASSWORD_RESET_TIMEOUT_SECONDS=86400
PASSWORD_RESET_MAIL_SENDER=0
MODEL_PROVIDER_TIMEOUT_SECONDS=120
PLUGIN_CATALOG_ROOT=/opt/centaeris/plugins
SANDBOX_MEMORY_BYTES=2147483648
SANDBOX_CPU_MILLI=2000
SANDBOX_PIDS_LIMIT=512
SANDBOX_DATA_TMPFS_BYTES=4294967296
OCI_RUNTIME=runc
KNOWLEDGE_PROCESSOR_IMAGE=centaeris-document-processor:1.0.0-cpu8
KNOWLEDGE_PROCESSOR_DEVICE=cpu
WORKER_LEASE_MS=120000
REDIS_MAXMEMORY=512mb
POSTGRES_TEST_HOST_PORT=55432
REDIS_TEST_HOST_PORT=6379
BOOTSTRAP_SUPERADMIN_EMAIL=admin@example.invalid
DEFAULT_FROM_EMAIL=noreply@example.invalid
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT_SECONDS=15
